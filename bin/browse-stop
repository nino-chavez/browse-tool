#!/usr/bin/env node
import { unlinkSync, existsSync } from "node:fs";
import { setTimeout as sleep } from "node:timers/promises";
import {
  stateFile,
  resolvePort,
  parseArgs,
  readState,
  portOwners,
  profileOf,
  clearLeasesForPort,
  allLeases,
  isLive,
  sessionId,
} from "../lib/connect.js";

// Stop whatever actually holds the debugging port, not merely the pid we happen
// to have recorded. Killing only the tracked pid is how orphans accumulate: the
// record goes stale (or the kill fails with ESRCH), the state file is deleted,
// and a live headless Chrome keeps the port. The next browse-start then reports
// success while every command drives the survivor.
/** Owners of `port` after giving an accepted SIGTERM time to actually land. */
async function waitForPortRelease(port, graceMs) {
  const deadline = Date.now() + graceMs;
  let owners = portOwners(port);
  while (owners.length && Date.now() < deadline) {
    await sleep(100);
    owners = portOwners(port);
  }
  return owners;
}

/**
 * Is a debuggable BROWSER answering on this port?
 *
 * portOwners() returns [] for two different situations — "nothing is listening"
 * and "lsof could not tell me" — and it is documented to fail open so it never
 * blocks ordinary work. Gating a destructive guard on that alone points the
 * fail-open the wrong way. This probe covers the second case.
 *
 * It does NOT cover the window where a Chrome has spawned but is not yet
 * listening: a TCP connect is refused then, so fetch throws and this returns
 * false, exactly as lsof returns []. An earlier version of this comment claimed
 * otherwise. That window is handled structurally instead — nothing is stopped,
 * so no other session's lease is cleared (see the end of this file).
 *
 * res.ok is not enough on its own: any HTTP 200 counts, and a dev server with
 * SPA history-fallback returns 200 for unknown paths, which would produce
 * "Refusing to stop the Chrome" for a Chrome that is not there. Verified against
 * a plain node http server. Require the DevTools payload, as browse-start
 * already does with info.Browser.
 */
async function browserResponds(port, timeoutMs = 800) {
  try {
    const res = await fetch(`http://127.0.0.1:${port}/json/version`, {
      signal: AbortSignal.timeout(timeoutMs),
    });
    if (!res.ok) return false;
    const info = await res.json();
    return Boolean(info?.webSocketDebuggerUrl || info?.Browser);
  } catch {
    return false;
  }
}

/**
 * targetIds open in the browser on `port`, or null if it could not be asked.
 *
 * This turns "which browser does that lease belong to?" from a guess into a
 * lookup. Leases written before the port field carry no port, and the guard
 * blocks on them because unknown must fail closed — but with seven such leases
 * live, browse-stop was refusing on EVERY port for the twelve hours until they
 * went stale, including ports those sessions demonstrably were not on. A lease
 * names a target; asking the browser whether it has that target answers the
 * question exactly.
 */
async function targetIdsOn(port, timeoutMs = 800) {
  try {
    const res = await fetch(`http://127.0.0.1:${port}/json/list`, {
      signal: AbortSignal.timeout(timeoutMs),
    });
    if (!res.ok) return null;
    const list = await res.json();
    if (!Array.isArray(list)) return null;
    return new Set(list.map((t) => t?.id).filter(Boolean));
  } catch {
    return null;
  }
}

// The port comes from --port / BROWSE_PORT, never from a file another session
// can overwrite. Reading it from shared state was the other half of the
// cross-session kill: session A would read session B's port, find B's pid as its
// legitimate owner, and SIGTERM it with nothing to flag — while A's own Chrome
// survived, unrecorded, holding a port for the next session to trip over.
const args = parseArgs(process.argv.slice(2), { force: "bool" });
const port = resolvePort(args.port);
const STATE_FILE = stateFile(port);
const state = readState(port);

// A containerised browser must not be stopped from here. portOwners() on a
// published Docker port returns the docker-proxy pid, not Chrome — killing it
// would tear down that port mapping for the daemon while leaving the browser
// running, and --force would make it worse rather than better. The box owns its
// own lifecycle; say so and stop.
if (state?.container) {
  console.error(
    `Port ${port} is a browser-box container (${state.container}), not a local Chrome.\n` +
      `Killing the port owner here would hit Docker's proxy, not the browser.\n` +
      `Stop it with:  browser-box stop --profile ${state.profileName ?? "default"}`,
  );
  process.exit(1);
}

const targets = new Set(portOwners(port));
const responds = await browserResponds(port);
const browserPresent = targets.size > 0 || responds;

// Refuse to stop a browser other sessions are working in.
//
// This is the largest blast radius in the tool and it was the only unguarded
// one: browse-tabs refuses to close a single tab under another live lease, and
// browse-start refuses a reseed while any lease is live, yet browse-stop killed
// the whole browser and wiped everyone's leases without a word. With one shared
// profile that is the default case — every session is on 9222. It also catches
// the near-miss where a session started on --port 9223, forgot to export
// BROWSE_PORT, and runs a bare browse-stop that resolves to 9222.
//
// A lease with no port counts as a match. Leases written before the port field
// existed have port === undefined, and an exact comparison excluded every one of
// them — the guard failed open on precisely the population it was added to
// protect, and killed a browser eight live sessions were using. A guard on a
// destructive path fails CLOSED: unknown means "could be this one".
//
// clearLeasesForPort() treats the same undefined the opposite way, and that is
// deliberate rather than inconsistent: there, matching means DELETING someone's
// lease, so unknown must not match. Both readings err away from destruction.
//
// Gated on a browser actually being present, because leases outlive their
// browser by up to STALE_MS: a crashed Chrome left live leases behind and the
// guard announced it was "Refusing to stop the Chrome on port N" for a browser
// that was not there.
const me = sessionId();
const others = allLeases().filter((l) => isLive(l) && l.id !== me);

// Ask the browser which targets it actually has, so a port-less lease can be
// attributed instead of assumed. Only when it cannot be asked does "unknown"
// stay unknown — and only then does the fail-closed block apply to it.
const liveTargets = await targetIdsOn(port);
const portless = others.filter((l) => l.port === undefined);
const attributed = liveTargets ? portless.filter((l) => liveTargets.has(l.targetId)) : [];
const unattributable = liveTargets ? [] : portless;

const onThisPort = [
  ...new Set([...others.filter((l) => l.port === port), ...attributed].map((l) => l.id)),
];
const unknownPort = [...new Set(unattributable.map((l) => l.id))];

if (browserPresent && (onThisPort.length || unknownPort.length) && !args.force) {
  const lines = [
    `Refusing to stop the Chrome on port ${port}.`,
    "",
    ...(onThisPort.length
      ? [`${onThisPort.length} live session(s) are driving it:`, ...onThisPort.map((s) => `  ${s}`)]
      : []),
    // Only reaches here when the browser could not be asked for its target list.
    // When it can, a port-less lease is attributed exactly and joins the group
    // above; claiming it is "driving port N" without checking would be a guess,
    // and blocking on the guess refused every port for twelve hours.
    ...(unknownPort.length
      ? [
          `${unknownPort.length} live session(s) hold a lease with no recorded port, and this`,
          `browser could not be asked which tabs it has, so they may be on it:`,
          ...unknownPort.map((s) => `  ${s}`),
        ]
      : []),
    "",
    `Stopping it would close their tabs and clear their leases. Leave it running — a`,
    `shared browser is meant to outlive any one session. Pass --force if you are sure.`,
    // Without a harness id, sessionId() falls back to ppid, so the same person
    // in two shells reads their own lease as a stranger's. Name the way out.
    ...(me.startsWith("ppid-")
      ? [
          "",
          `This session has no harness id and is identified as '${me}' (parent pid). If one`,
          `of those leases is your own from another shell, set BROWSE_SESSION to a stable`,
          `name in both so they are recognised as the same session.`,
        ]
      : []),
  ];
  console.error(lines.join("\n"));
  process.exit(1);
}

// A browser is answering but lsof could not name its pid, so there is no process
// to signal. This is reported rather than silently treated as "nothing to stop",
// because the browser is demonstrably there.
//
// --force does not help here and the message says so: force overrides the
// live-session guard, not the absence of a pid. An earlier version justified
// this branch by claiming that clearing state "would orphan every session using
// that browser" without ever consulting the lease sets computed above — a
// rationale that did not match its own condition.
if (responds && !targets.size) {
  console.error(
    `A browser is answering on port ${port}, but no process could be identified as its ` +
      `owner (lsof returned nothing).\nThere is no pid to signal, so nothing was stopped — ` +
      `--force cannot change that.\nQuit it by hand, then re-run.`,
  );
  process.exit(1);
}

// Kill only what actually holds the target port (`targets`, resolved above).
//
// State is keyed by port, so a recorded pid that does not own its own port is a
// genuinely stale record (a crashed Chrome, or one killed by hand) rather than
// another session's browser. Either way it is not ours to signal.
const stalePid = state?.pid && !targets.has(state.pid) ? state.pid : null;

if (stalePid) {
  console.log(
    `Ignoring recorded pid ${stalePid} (profile: ${profileOf(stalePid)}): it does not hold ` +
      `port ${port}. Clearing stale state only.`,
  );
}

if (!targets.size) {
  console.log(`Nothing to stop (no tracked Chrome, nothing listening on port ${port}).`);
} else {
  for (const pid of targets) {
    const label = `pid ${pid} (profile: ${profileOf(pid)})`;
    try {
      process.kill(pid, "SIGTERM");
      console.log(`Stopped Chrome ${label}.`);
    } catch (err) {
      // ESRCH just means it was already gone — that is a clean outcome here,
      // not the error the old version printed.
      if (err.code === "ESRCH") console.log(`Already gone: ${label}.`);
      else console.error(`Kill failed for ${label}: ${err.message}`);
    }
  }
}

// Confirm the browser is gone BEFORE touching state or leases.
//
// SIGTERM is asynchronous: Chrome unwinds and releases the listening socket some
// milliseconds after the signal is accepted. Checking immediately reported "still
// listening" and exited 1 on a kill that had in fact succeeded, which trained the
// reader to ignore this message — the exact opposite of the point. So poll, and
// only call it a survivor once it outlives the grace period.
//
// Ordering matters as much as the poll. This ran AFTER the cleanup, which meant
// "a browser was stopped" was really "a SIGTERM was sent": a signal accepted but
// not acted on within the grace period (hung renderer, a modal blocking shutdown)
// had already had every lease on its port deleted, and then printed "Kill
// manually before starting again" — leases wiped for a browser still serving
// them. Clean up only what is confirmed dead.
const survivors = targets.size ? await waitForPortRelease(port, 3000) : [];
if (survivors.length) {
  console.error(
    `\nStill listening on port ${port}: ${survivors.map((p) => `pid ${p} (${profileOf(p)})`).join(", ")}\n` +
      `Nothing was cleared — that browser is still serving its tabs.\n` +
      `Kill manually before starting again.`,
  );
  process.exit(1);
}

if (existsSync(STATE_FILE)) unlinkSync(STATE_FILE);

// Other sessions' leases are cleared only when a browser was CONFIRMED stopped.
//
// A lease points at a target inside a specific browser; that browser dying is
// what makes the lease dangling, and clearing it then is a courtesy. Clearing it
// when nothing was stopped is a guess about a browser we could not see — and it
// is the guess that made the spawned-but-not-yet-listening window dangerous,
// because leases would be wiped for a Chrome that was seconds from serving them.
// Gating on the confirmed stop removes that window structurally, rather than
// trying to detect it.
//
// With nothing stopped, only this session's own lease FOR THIS PORT goes.
// Not clearLease(), which is keyed by session and mode with no port: a
// `browse-stop --port 9333` that found nothing would then delete this session's
// live 9222 lease, orphaning its own tab.
const cleared = clearLeasesForPort(port, { sessionOnly: !targets.size });
if (cleared) {
  console.log(
    `Cleared ${cleared} tab lease(s) for port ${port}${targets.size ? "" : " (this session's only)"}.`,
  );
}
