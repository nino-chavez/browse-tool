#!/usr/bin/env node
import { unlinkSync, existsSync } from "node:fs";
import { setTimeout as sleep } from "node:timers/promises";
import {
  stateFile,
  resolvePort,
  parseArgs,
  readState,
  portOwners,
  profileOf,
  clearLeasesForPort,
  allLeases,
  isLive,
  sessionId,
} from "../lib/connect.js";

// Stop whatever actually holds the debugging port, not merely the pid we happen
// to have recorded. Killing only the tracked pid is how orphans accumulate: the
// record goes stale (or the kill fails with ESRCH), the state file is deleted,
// and a live headless Chrome keeps the port. The next browse-start then reports
// success while every command drives the survivor.
/** Owners of `port` after giving an accepted SIGTERM time to actually land. */
async function waitForPortRelease(port, graceMs) {
  const deadline = Date.now() + graceMs;
  let owners = portOwners(port);
  while (owners.length && Date.now() < deadline) {
    await sleep(100);
    owners = portOwners(port);
  }
  return owners;
}

/**
 * Is a debuggable browser answering on this port?
 *
 * portOwners() returns [] for two very different situations — "nothing is
 * listening" and "lsof could not tell me" — and it is documented to fail open so
 * it never blocks ordinary work. Gating a DESTRUCTIVE guard on that value turns
 * the fail-open into a fail-open on the wrong side. This probe distinguishes
 * them: it also catches the window where another session's Chrome has spawned
 * but is not yet listening.
 */
async function browserResponds(port, timeoutMs = 800) {
  try {
    const res = await fetch(`http://127.0.0.1:${port}/json/version`, {
      signal: AbortSignal.timeout(timeoutMs),
    });
    return res.ok;
  } catch {
    return false;
  }
}

// The port comes from --port / BROWSE_PORT, never from a file another session
// can overwrite. Reading it from shared state was the other half of the
// cross-session kill: session A would read session B's port, find B's pid as its
// legitimate owner, and SIGTERM it with nothing to flag — while A's own Chrome
// survived, unrecorded, holding a port for the next session to trip over.
const args = parseArgs(process.argv.slice(2), { force: "bool" });
const port = resolvePort(args.port);
const STATE_FILE = stateFile(port);
const state = readState(port);

const targets = new Set(portOwners(port));
const responds = await browserResponds(port);
const browserPresent = targets.size > 0 || responds;

// Refuse to stop a browser other sessions are working in.
//
// This is the largest blast radius in the tool and it was the only unguarded
// one: browse-tabs refuses to close a single tab under another live lease, and
// browse-start refuses a reseed while any lease is live, yet browse-stop killed
// the whole browser and wiped everyone's leases without a word. With one shared
// profile that is the default case — every session is on 9222. It also catches
// the near-miss where a session started on --port 9223, forgot to export
// BROWSE_PORT, and runs a bare browse-stop that resolves to 9222.
//
// A lease with no port counts as a match. Leases written before the port field
// existed have port === undefined, and an exact comparison excluded every one of
// them — the guard failed open on precisely the population it was added to
// protect, and killed a browser eight live sessions were using. A guard on a
// destructive path fails CLOSED: unknown means "could be this one".
//
// clearLeasesForPort() treats the same undefined the opposite way, and that is
// deliberate rather than inconsistent: there, matching means DELETING someone's
// lease, so unknown must not match. Both readings err away from destruction.
//
// Gated on a browser actually being present, because leases outlive their
// browser by up to STALE_MS: a crashed Chrome left live leases behind and the
// guard announced it was "Refusing to stop the Chrome on port N" for a browser
// that was not there.
const me = sessionId();
const others = allLeases().filter((l) => isLive(l) && l.id !== me);
const onThisPort = [...new Set(others.filter((l) => l.port === port).map((l) => l.id))];
const unknownPort = [...new Set(others.filter((l) => l.port === undefined).map((l) => l.id))];

if (browserPresent && (onThisPort.length || unknownPort.length) && !args.force) {
  const lines = [
    `Refusing to stop the Chrome on port ${port}.`,
    "",
    ...(onThisPort.length
      ? [`${onThisPort.length} live session(s) are driving it:`, ...onThisPort.map((s) => `  ${s}`)]
      : []),
    // Reported separately and honestly. Claiming these are "driving port N"
    // would be a guess: the lease predates the port field, so it may belong to
    // any browser. Blocking anyway is the fail-closed choice, but the message
    // should not dress a guess up as a fact.
    ...(unknownPort.length
      ? [
          `${unknownPort.length} live session(s) hold a lease with no recorded port,`,
          `so they may be on this browser or another:`,
          ...unknownPort.map((s) => `  ${s}`),
        ]
      : []),
    "",
    `Stopping it would close their tabs and clear their leases. Leave it running — a`,
    `shared browser is meant to outlive any one session. Pass --force if you are sure.`,
    // Without a harness id, sessionId() falls back to ppid, so the same person
    // in two shells reads their own lease as a stranger's. Name the way out.
    ...(me.startsWith("ppid-")
      ? [
          "",
          `This session has no harness id and is identified as '${me}' (parent pid). If one`,
          `of those leases is your own from another shell, set BROWSE_SESSION to a stable`,
          `name in both so they are recognised as the same session.`,
        ]
      : []),
  ];
  console.error(lines.join("\n"));
  process.exit(1);
}

// A browser is answering but lsof could not name its pid, so there is nothing to
// signal. Say so and change nothing: deleting the state and leases here would
// orphan every session's tab while the browser they point at keeps running.
if (responds && !targets.size) {
  console.error(
    `A browser is answering on port ${port}, but its process could not be identified ` +
      `(lsof returned nothing).\nNothing was stopped and no state was cleared — clearing it ` +
      `would orphan the tabs of every session using that browser.\nQuit it by hand, then re-run.`,
  );
  process.exit(1);
}

// Kill only what actually holds the target port (`targets`, resolved above).
//
// State is keyed by port, so a recorded pid that does not own its own port is a
// genuinely stale record (a crashed Chrome, or one killed by hand) rather than
// another session's browser. Either way it is not ours to signal.
const stalePid = state?.pid && !targets.has(state.pid) ? state.pid : null;

if (stalePid) {
  console.log(
    `Ignoring recorded pid ${stalePid} (profile: ${profileOf(stalePid)}): it does not hold ` +
      `port ${port}. Clearing stale state only.`,
  );
}

if (!targets.size) {
  console.log(`Nothing to stop (no tracked Chrome, nothing listening on port ${port}).`);
} else {
  for (const pid of targets) {
    const label = `pid ${pid} (profile: ${profileOf(pid)})`;
    try {
      process.kill(pid, "SIGTERM");
      console.log(`Stopped Chrome ${label}.`);
    } catch (err) {
      // ESRCH just means it was already gone — that is a clean outcome here,
      // not the error the old version printed.
      if (err.code === "ESRCH") console.log(`Already gone: ${label}.`);
      else console.error(`Kill failed for ${label}: ${err.message}`);
    }
  }
}

if (existsSync(STATE_FILE)) unlinkSync(STATE_FILE);

// Tab leases point at targets inside the Chrome we just killed. Left behind,
// the next session would spend a lookup miss on every command before falling
// through to a fresh tab.
//
// Scoped to this port: clearing every lease on the machine would orphan the tabs
// of sessions driving a different browser entirely, including on the path where
// there was nothing to stop in the first place.
const cleared = clearLeasesForPort(port);
if (cleared) console.log(`Cleared ${cleared} tab lease(s) for port ${port}.`);

// Report anything still holding the port, so a failure is visible now rather
// than as mysterious wrong-browser behaviour later.
//
// SIGTERM is asynchronous: Chrome unwinds and releases the listening socket
// some milliseconds after the signal is accepted. Checking immediately reported
// "still listening" and exited 1 on a kill that had in fact succeeded, which
// trained the reader to ignore this message — the exact opposite of the point.
// Poll for release, and only call it a survivor once it outlives the grace
// period.
const survivors = await waitForPortRelease(port, 3000);
if (survivors.length) {
  console.error(
    `\nStill listening on port ${port}: ${survivors.map((p) => `pid ${p} (${profileOf(p)})`).join(", ")}\n` +
      `Kill manually before starting again.`,
  );
  process.exit(1);
}
