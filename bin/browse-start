#!/usr/bin/env node
import { spawn, execSync } from "node:child_process";
import { mkdirSync, writeFileSync, existsSync, readdirSync, readlinkSync } from "node:fs";
import { platform, homedir } from "node:os";
import { join } from "node:path";
import { setTimeout as sleep } from "node:timers/promises";
import {
  DEFAULT_PORT,
  resolvePort,
  stateFile,
  parseArgs,
  readState,
  portOwners,
  portsOf,
  profileOf,
  userDataDirOf,
} from "../lib/connect.js";
import { liveLeaseCount } from "../lib/session.js";

const args = parseArgs(process.argv.slice(2), {
  profile: "bool",
  headless: "bool",
  reseed: "bool",
});
const port = resolvePort(args.port);
const STATE_FILE = stateFile(port);
// One shared profile by default.
//
// This used to default to basename(process.cwd()), which silently made the
// working directory an identity: every repo, worktree and audit scratch dir got
// its own Chrome profile. That reached 102 profiles / 74 GB, five of which had
// each downloaded the same 4 GB on-device model. Sessions share one browser and
// isolate at the tab level instead (see lib/session.js); logins are shared,
// which is the point — you log into a site once, not once per directory.
//
// A separate profile is only warranted for simultaneous DISTINCT authenticated
// identities on the same origin (e.g. meta-admin vs meta-setup). Pass
// --profile-name for those. For a logged-out view, prefer BROWSE_INCOGNITO=1,
// which isolates cookies in a BrowserContext without a second profile on disk.
const SHARED_PROFILE = "shared";
const profileName =
  args["profile-name"] ?? process.env.BROWSE_PROFILE ?? SHARED_PROFILE;

const profilesRoot = join(homedir(), ".browse-tool", "profiles");
const userDataDir = join(profilesRoot, profileName);

// One path for "the port is already taken", deliberately.
//
// "Is the tracked pid alive" is not the same question as "does it own the port".
// An orphan holding the port makes every later command drive the wrong browser
// while this script reports success, so ownership is established from lsof
// before anything else.
//
// There used to be a fast path above this: if the recorded pid owned the port,
// print "Chrome already running" and exit 0. Because adoption WRITES the state
// file, taking it once guaranteed every later browse-start on that port hit the
// fast path — which checked neither the profile nor --reseed nor headless mode.
// So `--profile --reseed` reported success without reseeding, and
// `--profile-name other` reported success while the running browser was
// `shared`. A shortcut that skips the checks is worse than no shortcut: the
// adoption branch below does the same job and validates first.
const owners = portOwners(port);
if (owners.length) {
  // Adopt, rather than refuse, when the squatter IS the browser being asked for.
  //
  // A shared browser outlives the session that started it, so "running but
  // untracked" is normal: the state file is per-port in $TMPDIR and any session
  // may have started it or stopped tracking it. Refusing there is unhelpful and
  // actively harmful — it strands a live Chrome with no state record, which
  // silently disables assertPortIdentity (it fails open on a null state), losing
  // the wrong-browser check for every later command. Recording it restores that.
  // Compare the FULL --user-data-dir against the path we already know we want,
  // rather than a basename derived from parsing. userDataDir is computed above
  // from profileName, so this is an exact comparison with no delimiter guessing —
  // the ambiguity that made a trailing URL read as the profile name.
  const byDir = owners.find((p) => userDataDirOf(p) === userDataDir);

  // Second, independent signal, because userDataDirOf() is still best-effort: it
  // reads ps output and returns null when ps fails or the path cannot be
  // resolved, and callers must not read null as a mismatch. The state file's pid
  // does not go through ps at all.
  //
  // This is deliberately NOT the old fast path: it is consulted here, inside the
  // adoption branch, so the profile / --reseed / headless checks below still run.
  // The shortcut that skipped them is what made those checks unreachable.
  const existing = readState(port);
  const byPid =
    existing?.pid && owners.includes(existing.pid) && existing.profileName === profileName
      ? existing.pid
      : null;
  const adopted = byDir ?? byPid;
  if (adopted) {
    // Adoption cannot satisfy --reseed, and must not report success as if it
    // had. Reseeding rsyncs --delete over Default/, which is precisely what the
    // guard below refuses to do beneath a running Chrome — so skipping the rsync
    // is right, and exiting 0 with "Adopted it" while the requested reseed
    // silently did not happen is the defect. Say what did not happen.
    if (args.reseed) {
      console.error(
        `Cannot reseed profile '${profileName}': it is open in a running Chrome ` +
          `(pid ${adopted}, port ${port}).\n` +
          `Reseeding rsyncs --delete over Default/ and would change identity underneath it.\n` +
          `Stop that browser first (browse-stop --port ${port}), then retry.`,
      );
      process.exit(1);
    }
    writeFileSync(
      STATE_FILE,
      JSON.stringify(
        { pid: adopted, port, userDataDir, profileName, adopted: true, started: Date.now() },
        null,
        2,
      ),
    );
    // Mode is not part of the adoption match — the profile is the identity — so
    // an adopted browser may not be headless/headed the way this call asked.
    // Flag the mismatch rather than let a --headless request appear honoured.
    const adoptedHeadless = / \[headless\]$/.test(profileOf(adopted));
    const modeNote =
      Boolean(args.headless) === adoptedHeadless
        ? ""
        : `\nNote: it is running ${adoptedHeadless ? "HEADLESS" : "HEADED"}, not ` +
          `${args.headless ? "headless" : "headed"} as this call asked. Stop it first to change mode.`;
    console.log(
      `Chrome already running on port ${port} with profile '${profileName}' (pid ${adopted}).\n` +
        `Adopted it — no second browser started.${modeNote}`,
    );
    process.exit(0);
  }

  const who = owners.map((p) => `  pid ${p}  profile: ${profileOf(p)}`).join("\n");
  console.error(
    `Port ${port} is already held by a Chrome running a DIFFERENT profile:\n${who}\n\n` +
      `Left alone, every browse-* command would drive that browser instead of the one\n` +
      `you are asking for. Run 'browse-stop' to clear it, or pass --port <n> for a\n` +
      `second instance.`,
  );
  process.exit(1);
}

// Chrome for Testing, installed under BROWSE_CHROME_HOME by
// `npx @puppeteer/browsers install chrome@stable`. Newest version wins, so an
// upgrade is an install and not an edit here.
function findChromeForTesting() {
  const root = join(process.env.BROWSE_CHROME_HOME || join(homedir(), ".browse-tool", "chrome"), "chrome");
  let versions;
  try {
    versions = readdirSync(root).sort();
  } catch {
    return null;
  }
  for (const v of versions.reverse()) {
    for (const arch of ["chrome-mac-arm64", "chrome-mac-x64"]) {
      const p = join(root, v, arch, "Google Chrome for Testing.app",
                     "Contents", "MacOS", "Google Chrome for Testing");
      if (existsSync(p)) return p;
    }
  }
  return null;
}

// Prefer a browser that is NOT your browser.
//
// macOS identifies an app by the bundle it was launched from, so a Chrome
// spawned out of /Applications/Google Chrome.app registers as com.google.Chrome
// — the same app you use. LaunchServices then has nothing to tell them apart,
// and clicking Chrome in the Dock activates whichever instance it finds first.
// When that is one of these boxes, the click succeeds against a process that has
// no window and cannot make one, so the browser appears frozen. Measured
// 2026-08-14: two agent boxes registered under com.google.Chrome, one of them
// as type="Foreground", and the Dock had been activating it for seven hours.
//
// Chrome for Testing is com.google.chrome.for.testing, a genuinely separate
// identity, which makes the collision impossible rather than unlikely. It also
// keys its cookies to "Chromium Safe Storage" instead of "Chrome Safe Storage" —
// so profiles written by /Applications Chrome lose their logins on first launch
// here (verified: 75 cookies in, 0 out), while cookies written under this binary
// persist across restarts and stay encrypted. That one-time cost is why this
// tool must hard-fail rather than quietly fall back to the user's browser.
function findChrome() {
  if (platform() === "darwin") {
    const cft = findChromeForTesting();
    if (cft) return cft;
    throw new Error(
      "Chrome for Testing is required on macOS. browse-tool will not fall back to\n" +
        "/Applications/Google Chrome.app because it can hijack your normal Chrome\n" +
        "instance. Install the separate binary once:\n" +
        "  mkdir -p ~/.browse-tool/chrome && cd ~/.browse-tool/chrome \\\n" +
        "    && npx @puppeteer/browsers install chrome@stable\n" +
        "Set CHROME_PATH only when you deliberately want a different browser binary.",
    );
  }
  if (platform() === "linux") {
    for (const cmd of ["google-chrome", "chromium", "chromium-browser"]) {
      try {
        return execSync(`which ${cmd}`, { stdio: ["ignore", "pipe", "ignore"] })
          .toString()
          .trim();
      } catch {}
    }
  }
  throw new Error("Chrome/Chromium not found. Install it or set CHROME_PATH.");
}

const chrome = process.env.CHROME_PATH || findChrome();
mkdirSync(userDataDir, { recursive: true });

const profileIsEmpty = () => {
  try {
    return readdirSync(userDataDir).filter((f) => f !== ".DS_Store").length === 0;
  } catch {
    return true;
  }
};

// Chrome allows exactly one instance per --user-data-dir and enforces it with a
// SingletonLock symlink named <host>-<pid>. Now that every session defaults to
// ONE shared profile, "someone already has it" is the routine collision, not an
// edge case — and Chrome's own response is to exit silently, which surfaced here
// as a bare "Chrome did not become ready on port N" after a 6-second wait. Name
// the holder and its port instead: the answer is almost always to use the browser
// that is already running, not to start a second one.
const singletonHolder = () => {
  try {
    const link = readlinkSync(join(userDataDir, "SingletonLock"));
    const pid = Number(link.split("-").pop());
    if (!Number.isInteger(pid) || pid <= 0) return null;
    process.kill(pid, 0); // throws ESRCH when the lock is stale
    return pid;
  } catch {
    return null;
  }
};

const holder = singletonHolder();
if (holder) {
  const heldPorts = [...new Set(portsOf(holder))];
  console.error(
    `Profile '${profileName}' is already open in Chrome (pid ${holder}` +
      `${heldPorts.length ? `, debugging port ${heldPorts.join(", ")}` : ""}).\n` +
      `Chrome permits one instance per profile, so a second one exits immediately.\n\n` +
      (heldPorts.length
        ? `Use the running browser instead:  export BROWSE_PORT=${heldPorts[0]}\n` +
          `Or stop it first:                 browse-stop --port ${heldPorts[0]}`
        : `Stop it first, or pass --profile-name <name> for a separate profile.`),
  );
  process.exit(1);
}

// Seeding rsyncs your real Chrome profile over this one. On the SHARED profile
// that rewrites the identity every other live session is currently using, so a
// reseed is refused while anyone holds a tab lease. An initial seed of an empty
// shared profile is fine — nobody is using it yet.
if (args.reseed && profileName === SHARED_PROFILE && !profileIsEmpty()) {
  const live = liveLeaseCount();
  if (live > 0) {
    console.error(
      `Refusing to reseed the shared profile: ${live} live session lease(s) are using it.\n` +
        `Reseeding rsyncs over Default/ and would change identity underneath them.\n` +
        `Either wait for those sessions to finish, or seed a named profile instead:\n` +
        `  browse-start --profile --profile-name <name>`,
    );
    process.exit(1);
  }
}

const shouldSeed = args.profile && (profileIsEmpty() || args.reseed);
if (args.profile && !shouldSeed) {
  console.log(
    `Using existing profile at ${userDataDir} (pass --reseed to overwrite from real Chrome).`,
  );
}
if (shouldSeed && platform() === "darwin") {
  const src = join(homedir(), "Library/Application Support/Google/Chrome/Default");
  if (existsSync(src)) {
    console.log(`Seeding profile '${profileName}' from ${src} ...`);
    try {
      execSync(
        `rsync -a --delete --exclude 'Cache' --exclude 'Code Cache' --exclude 'GPUCache' "${src}/" "${join(userDataDir, "Default")}/"`,
        { stdio: "inherit" },
      );
    } catch (e) {
      console.error("Profile sync failed:", e.message);
    }
  }
}

const chromeArgs = [
  `--remote-debugging-port=${port}`,
  `--user-data-dir=${userDataDir}`,
  "--no-first-run",
  "--no-default-browser-check",
  "--disable-features=ChromeWhatsNewUI",
];
if (args.headless) chromeArgs.push("--headless=new");

const child = spawn(chrome, chromeArgs, {
  detached: true,
  stdio: "ignore",
});
child.unref();

for (let i = 0; i < 40; i++) {
  await sleep(150);
  try {
    const res = await fetch(`http://127.0.0.1:${port}/json/version`);
    if (res.ok) {
      // A /json/version answer proves *something* is listening, not that it is
      // the Chrome we just spawned. Confirm ownership before recording state,
      // or we hand every later command a browser we never launched.
      const bound = portOwners(port);
      if (bound.length && !bound.includes(child.pid)) {
        const who = bound.map((p) => `pid ${p} (profile: ${profileOf(p)})`).join(", ");
        try { process.kill(child.pid, "SIGTERM"); } catch {}
        console.error(
          `Lost the race for port ${port}: it is held by ${who}, not the Chrome just started ` +
            `(pid ${child.pid}, profile '${profileName}').\nThat Chrome was stopped. Run 'browse-stop', then retry.`,
        );
        process.exit(1);
      }
      const info = await res.json();
      writeFileSync(
        STATE_FILE,
        JSON.stringify(
          { pid: child.pid, port, userDataDir, profileName, started: Date.now() },
          null,
          2,
        ),
      );
      console.log(`Chrome started on port ${port} (pid ${child.pid}).`);
      console.log(`  Browser: ${info.Browser}`);
      console.log(`  Profile: ${userDataDir}`);
      console.log(`  State:   ${STATE_FILE}`);
      // State is keyed by port, so a non-default port is not discoverable by the
      // other commands — they would silently address 9222 instead. Say so here
      // rather than letting the next browse-nav fail somewhere else.
      if (port !== DEFAULT_PORT) {
        console.log(
          `\n  This is not the default port. Every other browse-* command in this\n` +
            `  session needs to be told:  export BROWSE_PORT=${port}`,
        );
      }
      process.exit(0);
    }
  } catch {}
}

console.error("Chrome did not become ready on port", port);
process.exit(1);
