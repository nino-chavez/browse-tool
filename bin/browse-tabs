#!/usr/bin/env node
import {
  connect,
  parseArgs,
  sessionId,
  allLeases,
  isLive,
} from "../lib/connect.js";

// browse-tabs enumerates EVERY tab in the browser, across every session. That was
// harmless when one session owned the browser; with a shared profile it means the
// indices shift under you between the `list` you read and the `close` you run, and
// `close <index>` can take out another session's working tab.
//
// So: annotate ownership in `list`, and refuse to close a tab held by another
// session's live lease unless --force. Accepting a target id as well as an index
// gives a stable handle that a concurrent open/close cannot renumber.
const args = parseArgs(process.argv.slice(2), { force: "bool" });
const cmd = args._[0] ?? "list";

const browser = await connect();

/** targetId of a page, via the public CDP surface. */
async function targetIdOf(page) {
  try {
    const cdp = await page.createCDPSession();
    const { targetInfo } = await cdp.send("Target.getTargetInfo");
    await cdp.detach().catch(() => {});
    return targetInfo?.targetId ?? null;
  } catch {
    return null;
  }
}

try {
  const pages = await browser.pages();
  const ids = await Promise.all(pages.map(targetIdOf));

  const me = sessionId();
  const owners = new Map(); // targetId -> session id holding a live lease
  for (const lease of allLeases()) {
    if (lease.targetId && isLive(lease)) owners.set(lease.targetId, lease.id);
  }

  if (cmd === "list") {
    for (let i = 0; i < pages.length; i++) {
      const owner = owners.get(ids[i]);
      const mark = !owner ? " " : owner === me ? "*" : "~";
      const title = await pages[i].title().catch(() => "");
      const short = ids[i] ? ids[i].slice(0, 8) : "--------";
      console.log(`${mark} [${i}] ${short}  ${pages[i].url()}  ${title}`);
    }
    console.log(`\n* = this session's tab, ~ = another session's, blank = unclaimed`);
  } else if (cmd === "close") {
    const key = args._[1];
    if (key === undefined) {
      console.error("Usage: browse-tabs close <index|target-id> [--force]");
      process.exit(1);
    }
    // An in-range number is an index; anything else is matched as a target-id
    // prefix. Order matters and the obvious order is wrong: Chrome targetIds are
    // uppercase hex, so roughly ten in sixteen begin with a digit. Trying the id
    // prefix first made `close 1` resolve to "the first tab whose id starts with
    // 1" — closing a tab the user never named, which is the exact failure this
    // command was rewritten to prevent.
    const asIndex = /^\d+$/.test(String(key)) ? Number(key) : -1;
    const idx =
      asIndex >= 0 && asIndex < pages.length
        ? asIndex
        : ids.findIndex((id) => id && id.startsWith(String(key)));
    if (!pages[idx]) {
      console.error(`No tab matches '${key}'. Run 'browse-tabs list'.`);
      process.exit(1);
    }

    const owner = owners.get(ids[idx]);
    if (owner && owner !== me && !args.force) {
      console.error(
        `Tab [${idx}] (${ids[idx]?.slice(0, 8)}) is leased by another live session ` +
          `('${owner}').\nClosing it would pull the page out from under that session. ` +
          `Pass --force if you are sure.`,
      );
      process.exit(1);
    }

    await pages[idx].close();
    console.log(`Closed tab ${idx} (${ids[idx]?.slice(0, 8) ?? "unknown"}).`);
  } else {
    console.error("Usage: browse-tabs [list | close <index|target-id> [--force]]");
    process.exit(1);
  }
} finally {
  browser.disconnect();
}
