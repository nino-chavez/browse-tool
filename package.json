{
  "name": "browse-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Bash-invokable browser tools for coding agents. Replaces Chrome DevTools/Playwright MCP.",
  "bin": {
    "browse-start": "./bin/browse-start",
    "browse-stop": "./bin/browse-stop",
    "browse-nav": "./bin/browse-nav",
    "browse-eval": "./bin/browse-eval",
    "browse-screenshot": "./bin/browse-screenshot",
    "browse-shot": "./bin/browse-shot",
    "browse-pick": "./bin/browse-pick",
    "browse-feedback": "./bin/browse-feedback",
    "browse-tabs": "./bin/browse-tabs",
    "browse-markdown": "./bin/browse-markdown",
    "browse-crawl": "./bin/browse-crawl",
    "browse-events": "./bin/browse-events",
    "browse-cdp": "./bin/browse-cdp"
  },
  "scripts": {
    "test:annotations": "node --test tests/annotations.test.js",
    "test:feedback": "node --test tests/feedback-integration.test.js",
    "test:extension": "node --test tests/extension-browser.test.js",
    "build:extension": "node scripts/build-feedback-extension.mjs",
    "reader:check": "node tools/lib/encounter-audit.mjs --root=. --strict"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "jsdom": "^25.0.0",
    "puppeteer-core": "^23.0.0",
    "turndown": "^7.2.0",
    "zod": "^4.6.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=20"
  }
}
