{
  "manifest_version": 3,
  "name": "Page Feedback",
  "version": "0.2.0",
  "description": "Capture local page comments and screenshots for your coding agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Annotate this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": ""
}
